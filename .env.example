NODE_ENV=development
PORT=8080
APP_ORIGIN=http://localhost:8080
DATABASE_URL=postgres://fitmeal:fitmeal@localhost:5432/fitmeal
SESSION_DAYS=30
COOKIE_SECURE=false

# Admin bootstrap account. Change before production.
ADMIN_EMAIL=admin@fitmeal.vn
ADMIN_PASSWORD=change-this-password

# VNPAY sandbox credentials.
# Obtain these from VNPAY after registering a merchant/site.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay/return
VNPAY_IPN_URL=http://localhost:8080/api/payments/vnpay/ipn
VNPAY_ORDER_TYPE=other
VNPAY_LOCALE=vn
VNPAY_EXPIRE_MINUTES=15

# Optional: connect the FitMeal assistant to OpenAI. Keep this only on the server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
